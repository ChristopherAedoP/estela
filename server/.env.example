# Ejemplo de configuración del servidor (actas-server).
# Copia a /etc/actas-server.env en el servidor y completa los valores.
# NO pongas datos reales en este archivo de ejemplo (no se versiona el .env real).

# Token de Hugging Face (lectura) con licencias de pyannote aceptadas. Requerido para diarización.
ACTAS_HF_TOKEN=<tu-token-hf>

# Modelo LLM en Ollama para el resumen.
ACTAS_OLLAMA_MODEL=gemma4:12b-it-qat
# URL de Ollama (normalmente local en el mismo servidor)
ACTAS_OLLAMA_URL=http://127.0.0.1:11434

# Modelo de Whisper y precisión
ACTAS_WHISPER_MODEL=large-v3
ACTAS_WHISPER_DEVICE=cuda
ACTAS_WHISPER_COMPUTE=float16
ACTAS_LANGUAGE=es

# Carpeta donde archivar el audio (ej. un montaje NFS)
ACTAS_AUDIO_DIR=/mnt/actas/audio

# Acotar nº de hablantes en la diarización (opcional; vacío = sin límite)
ACTAS_MAX_SPEAKERS=
ACTAS_MIN_SPEAKERS=
