[Unit]
Description=Estela actas-server
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
# Ajusta el usuario al propietario del venv, que ademas debe poder escribir en
# ACTAS_AUDIO_DIR. Creacion: sudo useradd --system --home /opt/actas-server actas
User=actas
Group=actas
WorkingDirectory=/opt/actas-server

# Toda la configuracion vive en este archivo: ACTAS_AUDIO_DIR, ACTAS_HF_TOKEN,
# ACTAS_OLLAMA_URL, ACTAS_OLLAMA_MODEL... No se versiona ni lo copia deploy.ps1
# porque contiene el token de Hugging Face. El guion inicial hace que el servicio
# arranque igual si todavia no existe, usando los valores por defecto.
EnvironmentFile=-/etc/actas-server.env

# El guion resuelve LD_LIBRARY_PATH a partir del venv, para no cablear aqui la
# version de Python.
ExecStart=/opt/actas-server/actas-server-start.sh

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
